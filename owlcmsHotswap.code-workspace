{
  "folders": [
    {
      "path": "."
    }
  ],
  "settings": {
    "debug.toolBarLocation": "docked",
    "java.autobuild.enabled": true,
    "java.configuration.runtimes": [
      {
        "name": "JavaSE-17",
        "path": "C:\\Dev\\Java\\jbrsdk-17.0.6-windows-x64-b779.1",
        "default": true
      }
    ],
    "java.import.gradle.enabled": false,
    "terminal.integrated.defaultProfile.windows": "Git Bash",
    "java.compile.nullAnalysis.mode": "disabled",
    "java.configuration.updateBuildConfiguration": "interactive",
    "java.annotation.processing.enabled": false,
    "java.autobuild.annotation.processing.enabled": false
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "type": "java",
        "name": "Launch owlcms (Hotswap)",
        "request": "launch",
        "mainClass": "app.owlcms.Main",
        "projectName": "owlcms",
        "vmArgs": "-ea -Dlogback.configurationFile=logback-console.xml -XX:+AllowEnhancedClassRedefinition -XX:HotswapAgent=fatjar",
        "env": {
          "OWLCMS_MEMORYMODE": "false",
          "OWLCMS_INITIALDATA": "LARGEGROUP_DEMO",
          // "OWLCMS_LOCALDIR": "C:\\Dev\\git\\usaw-owlcms\\local"
        }
      },
      {
        "type": "java",
        "name": "Launch publicresults (Hotswap)",
        "request": "launch",
        "mainClass": "app.owlcms.publicresults.Main",
        "projectName": "publicresults",
        "vmArgs": "-ea -Dlogback.configurationFile=logback-console.xml -XX:+AllowEnhancedClassRedefinition -XX:HotswapAgent=fatjar",
        "env": {
          "OWLCMS_PORT": "8082",
          "OWLCMS_UPDATEKEY": "mapetitevacheamalauxpattes"
        }
      },
      {
        "type": "java",
        "name": "Launch - Current File (Hotswap)",
        "request": "launch",
        "mainClass": "${file}",
        "vmArgs": "-ea -Dlogback.configurationFile=logback-console.xml -XX:+AllowEnhancedClassRedefinition -XX:HotswapAgent=fatjar"
      }
    ]
  }
}