{
    "version": "0.2.0",
    "description": "Launch configurations for OWLCMS development",
    "configurations": [
        {
            "type": "java",
            "name": "owlcms database +no editing",
            "request": "launch",
            "mainClass": "app.owlcms.Main",
            "projectName": "owlcms",
            "vmArgs": "-Dvaadin.frontend.hotdeploy=false -DcssEdit=false -Dlogback.configurationFile=logback-console.xml -Dvaadin.devmode.hostsAllowed=*  -Dvaadin.devmode.devTools.enabled=false -ea -Dlogback.configurationFile=logback-console.xml",
            "env":{"OWLCMS_MEMORYMODE": "false"}
        },
        {
            "type": "java",
            "name": "owlcms database + javascript editing",
            "request": "launch",
            "mainClass": "app.owlcms.Main",
            "projectName": "owlcms",
            "vmArgs": "-Dvaadin.frontend.hotdeploy=true -DcssEdit=true -Dlogback.configurationFile=logback-console.xml -Dvaadin.devmode.hostsAllowed=*  -Dvaadin.devmode.devTools.enabled=false -ea -Dlogback.configurationFile=logback-console.xml",
            "env":{"OWLCMS_MEMORYMODE": "false"}
        },
        {
            "type": "java",
            "name": "owlcms demodata + javascript editing",
            "request": "launch",
            "mainClass": "app.owlcms.Main",
            "projectName": "owlcms",
            "vmArgs": "-Dvaadin.frontend.hotdeploy=true -DcssEdit=true -Dlogback.configurationFile=logback-console.xml -Dvaadin.devmode.hostsAllowed=*  -Dvaadin.devmode.devTools.enabled=false -ea -Dlogback.configurationFile=logback-console.xml",
            "env":{"OWLCMS_PORT": "8081", "OWLCMS_MEMORYMODE": "true", "OWLCMS_INITIALDATA": "LARGEGROUP_DEMO"}
        },
        {
            "type": "java",
            "name": "Launch - Current File",
            "request": "launch",
            "mainClass": "${file}"
        }
    ]
}