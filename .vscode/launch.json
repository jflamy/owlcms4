      "name": "🟨 EDIT owlcms no reset ",
      "request": "launch",
      "mainClass": "${config:owlcms.mainClass}",
      "projectName": "owlcms",
      "cwd": "${workspaceFolder}/owlcms",
      "vmArgs": "-Dvaadin.frontend.hotdeploy=true ${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false",
        // default is to ignore event forwarding by forcing "" as URL
        // comment out the next two lines to use what is in the database
        "OWLCMS_VIDEODATA": "",
        "OWLCMS_REMOTE": "",
