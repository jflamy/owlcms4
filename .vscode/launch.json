    {
      "type": "java",
      "name": "🟠 publicresults",
      "request": "launch",
      "mainClass": "app.owlcms.publicresults.Main",
      "projectName": "publicresults",
      "cwd": "${workspaceFolder}/publicresults",
      "vmArgs": "${config:owlcms.vmArgs}",
