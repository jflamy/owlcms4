{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "🟨 owlcms no reset",
      "request": "launch",
      "mainClass": "${config:owlcms.mainClass}",
      "projectName": "owlcms",
      "cwd": "${workspaceFolder}/owlcms",
      "vmArgs": "${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false",
        // default is to ignore event forwarding by forcing "" as URL
        // comment out the next two lines to use what is in the database
        "OWLCMS_VIDEODATA": "",
        "OWLCMS_REMOTE": "",
        "OWLCMS_PORT": "8080",
        //"OWLCMS_ENABLEEMBEDDEDMQTT": "false"
        //"OWLCMS_VIDEODATAKEY": "amalauxpattes",
        //"OWLCMS_UPDATEKEY": "mapetitevache"
      }
    },
    {
      "type": "java",
      "name": "🟨 owlcms no reset + file logs",
      "request": "launch",
      "preLaunchTask": "clear owlcms file logs",
      "mainClass": "${config:owlcms.mainClass}",
      "projectName": "owlcms",
      "cwd": "${workspaceFolder}/owlcms",
      "vmArgs": "${config:owlcms.vmArgs} -Dlogback.configurationFile=logback.xml",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        // default is to ignore event forwarding by forcing "" as URL
        // comment out the next two lines to use what is in the database
        "OWLCMS_VIDEODATA": "",
        "OWLCMS_REMOTE": "",
        //"OWLCMS_VIDEODATAKEY": "amalauxpattes",
        //"OWLCMS_UPDATEKEY": "mapetitevache"
        // temporary for playwright testings
        //"OWLCMS_MEMORYMODE": "true",
        //"OWLCMS_INITIALDATA": "SINGLE_ATHLETE_GROUPS",
      }
    },
    {
      "type": "java",
      "name": "🟨 owlcms → tracker",
      "request": "launch",
      "mainClass": "${config:owlcms.mainClass}",
      "projectName": "owlcms",
      "cwd": "${workspaceFolder}/owlcms",
      "vmArgs": "${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false",
        "OWLCMS_VIDEODATA": "ws://127.0.0.1:8096/ws", //"wss://fhq-tracker.fly.dev/ws",
        // "OWLCMS_VIDEODATAKEY": "amalauxpattes",
        "OWLCMS_REMOTE": "", //"http://127.0.0.1:8082",
        // "OWLCMS_UPDATEKEY": "mapetitevache"
      }
    },
    {
      "type": "java",
      "name": "🟨 owlcms → publicresults",
      "request": "launch",
