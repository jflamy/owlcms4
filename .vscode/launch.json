{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "java",
      "name": "🟨 owlcms no reset",
      "request": "launch",
      "console": "integratedTerminal",
      "mainClass": "app.owlcms.Main",
      "projectName": "owlcms",
      "vmArgs": "${config:owlcms.vmArgs}",
      "windows": {
        "envFile": "${workspaceFolder}\\.vscode\\.env.windows"
      },
      "linux": {
        "envFile": "${workspaceFolder}/.vscode/.env.linux"
      },
      "osx": {
        "envFile": "${workspaceFolder}/.vscode/.env.mac"
      },
      "env": {
        "OWLCMS_MEMORYMODE": "false",
     }
    },
