      "type": "java",
      "name": "🟩 EDIT large demo owlcms memory",
      "request": "launch",
      "preLaunchTask": "clear owlcms file logs",
      "mainClass": "${config:owlcms.mainClass}",
      "projectName": "owlcms",
      "cwd": "${workspaceFolder}/owlcms",
      "vmArgs": "${config:owlcms.vmArgs} -Dvaadin.frontend.hotdeploy=true -Dlogback.configurationFile=logback.xml",
