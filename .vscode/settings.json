{
    // Basic file exclusions to keep workspace clean
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },

    // JDK selection (project-level): use JetBrains Runtime (DCEVM) for enhanced hotswap
    "java.configuration.runtimes": [
        
        {
            "name": "JavaSE-25",
            "path": "C:\\Dev\\Java\\jbr_jcef-25.0.1-windows-x64-b266.34",
            "default": true
        }
    ],
    "java.jdt.ls.java.home": "C:\\Dev\\Java\\jbr_jcef-25.0.1-windows-x64-b266.34",

    // Java performance and autobuild
    "java.autobuild.enabled": true,
    "java.autobuild.annotation.processing.enabled": false,
    "java.annotation.processing.enabled": false,
    "java.import.gradle.enabled": false,
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.project.importOnFirstTimeStartup": "disabled",
    "java.server.launchMode": "Standard",
    "java.project.importHint": false,
    "java.saveActions.organizeImports": true,
    "java.validate.allOpenBuffersOnChanges": false,
    "java.validate.enable": true,
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        "target",
        ".vscode",
        ".idea"
    ],
    // Java editor and completion features
    "java.completion.enabled": true,
    "java.signatureHelp.enabled": true,
    "java.hover.enabled": true,
    "java.format.enabled": true,
    // Debug and terminal
    "debug.toolBarLocation": "docked",
    "debug.allowBreakpointsEverywhere": true,
    "terminal.integrated.env.windows": {
        "JAVA_HOME": "C:\\Dev\\Java\\jbr_jcef-25.0.1-windows-x64-b266.34"
    },
    "editor.stickyScroll.enabled": false,
    "workbench.tree.enableStickyScroll": false,
    // Explorer auto-reveal when switching tabs
    "explorer.autoReveal": true,
    "java.compile.nullAnalysis.mode": "disabled",

    // Disable built-in Markdown link validation to prevent false positives
    "markdown.validate.enabled": false
}