{
    // Basic file exclusions to keep workspace clean
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    // Java performance and autobuild
    "java.autobuild.enabled": true,
    "java.autobuild.annotation.processing.enabled": false,
    "java.annotation.processing.enabled": false,
    "java.import.gradle.enabled": false,
    "java.configuration.updateBuildConfiguration": "disabled",
    "java.project.importOnFirstTimeStartup": "disabled",
    "java.server.launchMode": "Standard",
    "java.project.importHint": false,
    "java.saveActions.organizeImports": true,
    "java.validate.allOpenBuffersOnChanges": false,
    "java.validate.enable": true,
    "java.project.resourceFilters": [
        "node_modules",
        ".git",
        "target",
        ".vscode",
        ".idea"
    ],
    // Java editor and completion features
    "java.completion.enabled": true,
    "java.signatureHelp.enabled": true,
    "java.hover.enabled": true,
    "java.format.enabled": true,
    // Debug and terminal
    "debug.toolBarLocation": "docked",
    "debug.allowBreakpointsEverywhere": true,
    "workbench.colorCustomizations": {
        "terminal.foreground": "#FFFFFF",
        "debugConsole.infoForeground": "#FFFFFF",
        "debugConsole.warningForeground": "#FFFFFF",
        "debugConsole.errorForeground": "#FFFFFF",
        "terminal.ansiBlue": "#FFFFFF",
        "terminal.ansiBrightBlue": "#FFFFFF"
    },
    "editor.stickyScroll.enabled": false,
}