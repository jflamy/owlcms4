{
    // Basic file exclusions to keep workspace clean
    "files.exclude": {
        "**/.classpath": true,
        "**/.project": true,
        "**/.settings": true,
        "**/.factorypath": true
    },
    // Disable annotation processing to prevent VS Code from modifying .classpath files
    "java.annotation.processing.enabled": false,
    "java.autobuild.annotation.processing.enabled": false
}