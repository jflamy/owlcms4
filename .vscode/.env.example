# This simulates the control panel and is used to check locality (?token= or Authorization: Bearer)
# This can be used as an emergency unlock for accounts mode (log in as admin with this value as password)
# This is a development environment value only; the real control panel generates a new one at each launch
OWLCMS_CONTROLPANELTOKEN=devControlPanelTokenChangeItForProduction

# Default server port. Change it if another application already uses 8080.
#OWLCMS_PORT=8080
